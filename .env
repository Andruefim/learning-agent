# Level 1 — Ollama planner
# In WSL, 127.0.0.1 is rewritten to the Windows host gateway.
L1_MODEL=qwen3.5:9b-q8_0
L1_BASE_URL=http://127.0.0.1:11434

# Level 2 — in-context policy (cpu / cuda / rocm)
L2_DEVICE=rocm

# Level 3 — physics + flywheel
# MuJoCo offscreen GL: egl = headless GPU (Linux/WSL), glfw = windowed (macOS/desktop)
MUJOCO_GL=glfw
STORAGE_DIR=./flywheel_data
PORT=8000
