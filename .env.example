# Level 1 — Ollama VLM (camera JPEG + language)
# In WSL, 127.0.0.1 is the Linux VM. Leave this default: the app rewrites it to the Windows host.
L1_MODEL=qwen3.8:latest
L1_BASE_URL=http://127.0.0.1:11434

# Level 2 — tracker is live; flow student is gated
L2_DEVICE=cpu
L2_DRIVE=0

# Level 3 — physics + replay
# MuJoCo offscreen GL: egl = headless GPU (Linux/WSL), glfw = windowed (macOS/desktop)
MUJOCO_GL=egl
STORAGE_DIR=./flywheel_data
PORT=8000
