# Level 1 — Ollama planner
# In WSL, 127.0.0.1 is rewritten to the Windows host gateway.
# L1 planner. If GEMINI_API_KEY is set, Ollama is not used.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
L1_MODEL=qwen3.5:9b
L1_BASE_URL=http://127.0.0.1:11434

# Level 2 — cpu; GPU reserved for one teacher
L2_DEVICE=cpu

# DEPRECATED π0/π0.5 whole-body path (agent/e2e.py). Keep off.
E2E_ENABLE=0
E2E_DEVICE=cuda

# Arms-only π0 (off by default)
PI0_ENABLE=0
PI0_DEVICE=cuda

# Headless oven student eval only (§3.6). Interactive ALPHA_MAX stays 0.12.
STUDENT_ONLY_EVAL=0

# Level 3 — physics + flywheel
# MuJoCo offscreen GL: egl = headless GPU (Linux/WSL), glfw = windowed (macOS/desktop)
MUJOCO_GL=glfw
STORAGE_DIR=./flywheel_data
PORT=8000

HF_TOKEN=
