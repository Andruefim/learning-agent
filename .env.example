# Primary VLM (Cloud Gemini) + Automatic Local Ollama Fallback
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
L1_MODEL=qwen3.5:9b
L1_BASE_URL=http://127.0.0.1:11434

# SLEEP VLA compute device (cuda | cpu)
SLEEP_DEVICE=cuda

# MuJoCo offscreen GL: glfw (Windows/macOS), egl (Linux headless)
MUJOCO_GL=glfw
STORAGE_DIR=./checkpoints
PORT=8000
