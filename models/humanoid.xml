<mujoco model="humanoid">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.42 0.42 0.48" diffuse="0.55 0.55 0.55"/>
  </visual>
  <default>
    <joint damping="4" armature="0.02" actuatorgravcomp="true"/>
    <geom condim="3" friction="1.6 0.1 0.1" solref="0.012 1"/>
    <position kp="280" dampratio="1.2"/>
  </default>
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="256" height="256"
             rgb1="0.10 0.10 0.12" rgb2="0.16 0.16 0.18"/>
    <material name="grid" texture="grid" texrepeat="8 8" texuniform="true"/>
  </asset>
  <worldbody>
    <light pos="0.4 -2.2 4.0" dir="0 0.25 -1" diffuse="1 1 1"/>
    <geom type="plane" size="6 6 0.05" material="grid"/>
    <camera name="demo" pos="2.6 -2.8 1.45" mode="targetbody" target="torso" fovy="46"/>

    <body name="torso" pos="0 0 0.90">
      <freejoint name="root"/>
      <geom name="torso" type="capsule" fromto="0 0 -0.14 0 0 0.16" size="0.085"
            rgba="0.86 0.87 0.90 1" mass="9"/>
      <geom name="head" type="sphere" pos="0 0 0.28" size="0.075"
            rgba="0.90 0.91 0.93 1" mass="1.2"/>
      <site name="gaze" pos="0.08 0 0.28" size="0.01"/>

      <body name="r_upper_arm" pos="0.02 -0.13 0.12">
        <joint name="r_shoulder" type="hinge" axis="0 1 0" range="-1.6 1.8"/>
        <joint name="r_shoulder_x" type="hinge" axis="1 0 0" range="-1.3 1.3"/>
        <geom type="capsule" fromto="0 0 0 0.22 0 -0.04" size="0.032" rgba="0.22 0.55 0.86 1" mass="1.1"/>
        <body name="r_lower_arm" pos="0.22 0 -0.04">
          <joint name="r_elbow" type="hinge" axis="0 1 0" range="-2.2 0.1"/>
          <geom type="capsule" fromto="0 0 0 0.20 0 0" size="0.026" rgba="0.22 0.55 0.86 1" mass="0.7"/>
        </body>
      </body>
      <body name="l_upper_arm" pos="0.02 0.13 0.12">
        <joint name="l_shoulder" type="hinge" axis="0 1 0" range="-1.6 1.8"/>
        <joint name="l_shoulder_x" type="hinge" axis="1 0 0" range="-1.3 1.3"/>
        <geom type="capsule" fromto="0 0 0 0.22 0 -0.04" size="0.032" rgba="0.22 0.55 0.86 1" mass="1.1"/>
        <body name="l_lower_arm" pos="0.22 0 -0.04">
          <joint name="l_elbow" type="hinge" axis="0 1 0" range="-2.2 0.1"/>
          <geom type="capsule" fromto="0 0 0 0.20 0 0" size="0.026" rgba="0.22 0.55 0.86 1" mass="0.7"/>
        </body>
      </body>

      <body name="r_thigh" pos="0 -0.09 -0.16">
        <joint name="r_hip_x" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <joint name="r_hip_z" type="hinge" axis="0 0 1" range="-0.8 0.8"/>
        <joint name="r_hip_y" type="hinge" axis="0 1 0" range="-1.4 0.5"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.36" size="0.045" rgba="0.28 0.32 0.40 1" mass="3.2"/>
        <body name="r_shin" pos="0 0 -0.36">
          <joint name="r_knee" type="hinge" axis="0 1 0" range="0 2.1"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.34" size="0.038" rgba="0.28 0.32 0.40 1" mass="2.0"/>
          <body name="r_foot" pos="0 0 -0.34">
            <joint name="r_ankle" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <joint name="r_ankle_z" type="hinge" axis="0 0 1" range="-0.8 0.8"/>
            <geom name="r_foot" type="box" size="0.12 0.06 0.02" pos="0.07 0 -0.02"
                  rgba="0.18 0.18 0.20 1" mass="0.9"/>
          </body>
        </body>
      </body>
      <body name="l_thigh" pos="0 0.09 -0.16">
        <joint name="l_hip_x" type="hinge" axis="1 0 0" range="-0.6 0.6"/>
        <joint name="l_hip_z" type="hinge" axis="0 0 1" range="-0.8 0.8"/>
        <joint name="l_hip_y" type="hinge" axis="0 1 0" range="-1.4 0.5"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.36" size="0.045" rgba="0.28 0.32 0.40 1" mass="3.2"/>
        <body name="l_shin" pos="0 0 -0.36">
          <joint name="l_knee" type="hinge" axis="0 1 0" range="0 2.1"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.34" size="0.038" rgba="0.28 0.32 0.40 1" mass="2.0"/>
          <body name="l_foot" pos="0 0 -0.34">
            <joint name="l_ankle" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <joint name="l_ankle_z" type="hinge" axis="0 0 1" range="-0.8 0.8"/>
            <geom name="l_foot" type="box" size="0.12 0.06 0.02" pos="0.07 0 -0.02"
                  rgba="0.18 0.18 0.20 1" mass="0.9"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <position joint="r_shoulder" ctrlrange="-1.6 1.8"/>
    <position joint="r_shoulder_x" ctrlrange="-1.3 1.3"/>
    <position joint="r_elbow" ctrlrange="-2.2 0.1"/>
    <position joint="l_shoulder" ctrlrange="-1.6 1.8"/>
    <position joint="l_shoulder_x" ctrlrange="-1.3 1.3"/>
    <position joint="l_elbow" ctrlrange="-2.2 0.1"/>
    <position joint="r_hip_x" ctrlrange="-0.6 0.6"/>
    <position joint="r_hip_z" ctrlrange="-0.8 0.8"/>
    <position joint="r_hip_y" ctrlrange="-1.4 0.5"/>
    <position joint="r_knee" ctrlrange="0 2.1"/>
    <position joint="r_ankle" ctrlrange="-0.8 0.8"/>
    <position joint="r_ankle_z" kp="110" dampratio="1.0" ctrlrange="-0.8 0.8"/>
    <position joint="l_hip_x" ctrlrange="-0.6 0.6"/>
    <position joint="l_hip_z" ctrlrange="-0.8 0.8"/>
    <position joint="l_hip_y" ctrlrange="-1.4 0.5"/>
    <position joint="l_knee" ctrlrange="0 2.1"/>
    <position joint="l_ankle" ctrlrange="-0.8 0.8"/>
    <position joint="l_ankle_z" kp="110" dampratio="1.0" ctrlrange="-0.8 0.8"/>
  </actuator>
  <keyframe>
    <key name="stand" qpos="0 0 0.90  1 0 0 0
         1.45 0 -0.20  1.45 0 -0.20
         0 0 -0.18 0.36 -0.16 0
         0 0 -0.18 0.36 -0.16 0"/>
  </keyframe>
</mujoco>
